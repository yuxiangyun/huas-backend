# Server
PORT=3000
NODE_ENV=production
SERVER_IDLE_TIMEOUT_SECONDS=60

# JWT secret (MUST change in production)
JWT_SECRET=your-random-secret-at-least-32-chars

# Admin login (used to create short-lived HttpOnly sessions)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password

# Database (production blue-green must use an absolute shared persistent path)
DB_PATH=./data/huas.db

# Logging
LOG_LEVEL=info

# Timezone (fixed to Beijing time)
TIMEZONE=Asia/Shanghai
TZ=Asia/Shanghai

# Per-user max grade cache entries (LRU eviction)
GRADES_CACHE_LIMIT=20

# Per-user max schedule cache entries (LRU eviction)
SCHEDULE_CACHE_LIMIT=120
PORTAL_SCHEDULE_CACHE_LIMIT=120

# Backend-controlled schedule source priority and shared hot-state file
SCHEDULE_SOURCE_MODE=mobile-jw-first
# Defaults to dirname(DB_PATH)/schedule-source-policy.json. Override only with an absolute shared path:
# SCHEDULE_SOURCE_POLICY_FILE=/var/lib/huas-server/schedule-source-policy.json

# Business upstream retry
BUSINESS_RETRY_MAX_ATTEMPTS=2
BUSINESS_RETRY_BASE_DELAY_MS=200
BUSINESS_RETRY_MAX_DELAY_MS=800
BUSINESS_RETRY_JITTER_MS=100

# Auth login failure rate limit
AUTH_LOGIN_RATE_LIMIT_MAX_FAILURES=20
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=300000
AUTH_LOGIN_RATE_LIMIT_BLOCK_MS=600000


# School service accounts
CLASSROOM_ADMIN_STUDENT_ID=202412040130

# Discover media
DISCOVER_STORAGE_ROOT=./data/discover
DISCOVER_MEDIA_BASE_PATH=/media/discover
DISCOVER_MAX_IMAGES=9
DISCOVER_MAX_TAGS=6
DISCOVER_MAX_TITLE_LENGTH=80
DISCOVER_MAX_TAG_LENGTH=12
DISCOVER_MAX_STORE_NAME_LENGTH=32
DISCOVER_MAX_PRICE_TEXT_LENGTH=20
DISCOVER_MAX_CONTENT_LENGTH=400
DISCOVER_MAX_COMMENT_LENGTH=200
DISCOVER_DEFAULT_COMMENT_PAGE_SIZE=50
DISCOVER_MAX_COMMENT_PAGE_SIZE=100
DISCOVER_IMAGE_MAX_BYTES=33554432
DISCOVER_IMAGE_MAX_DIMENSION=1280
DISCOVER_IMAGE_QUALITY=78
DISCOVER_ORPHAN_MEDIA_GRACE_MS=3600000

# Community profile avatar media
# Keep /media/treehole-avatar so migrated profile URLs remain valid.
COMMUNITY_AVATAR_STORAGE_ROOT=./data/treehole-avatars
COMMUNITY_AVATAR_MEDIA_BASE_PATH=/media/treehole-avatar
COMMUNITY_AVATAR_MAX_BYTES=2097152
COMMUNITY_AVATAR_MAX_DIMENSION=512
COMMUNITY_AVATAR_QUALITY=78
COMMUNITY_AVATAR_ORPHAN_GRACE_MS=3600000

# Treehole
TREEHOLE_STORAGE_ROOT=./data/treehole-post-media
TREEHOLE_USER_MEDIA_BASE_PATH=/api/treehole/media
TREEHOLE_ADMIN_MEDIA_BASE_PATH=/api/admin/treehole/media
TREEHOLE_MAX_POST_LENGTH=500
TREEHOLE_MAX_COMMENT_LENGTH=200
TREEHOLE_DEFAULT_PAGE_SIZE=20
TREEHOLE_MAX_PAGE_SIZE=50
TREEHOLE_DEFAULT_COMMENT_PAGE_SIZE=50
TREEHOLE_MAX_COMMENT_PAGE_SIZE=100
TREEHOLE_MAX_IMAGES=9
TREEHOLE_IMAGE_MAX_BYTES=12582912
TREEHOLE_IMAGE_TOTAL_MAX_BYTES=33554432
TREEHOLE_IMAGE_MAX_PIXELS=16000000
TREEHOLE_IMAGE_MAX_OUTPUT_BYTES=1048576
TREEHOLE_IMAGE_MAX_DIMENSION=1280
TREEHOLE_IMAGE_QUALITY=78
TREEHOLE_ORPHAN_MEDIA_GRACE_MS=3600000
TREEHOLE_UPLOAD_MAX_ACTIVE=1
TREEHOLE_UPLOAD_MAX_QUEUED=2

CALENDAR_BASE_URL=http://localhost:3000/
CALENDAR_SECRET=rili-secret
